# Breeth memory server (optional — the app falls back to localStorage when unset).
# Add these to Vercel (Settings → Environment Variables) or your local .env.local.
NEXT_PUBLIC_BREETH_URL=https://your-breeth-host.example.com
NEXT_PUBLIC_BREETH_KEY=your-breeth-api-key

# Real Google sign-in (optional — falls back to the mock until a Client ID is set).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
